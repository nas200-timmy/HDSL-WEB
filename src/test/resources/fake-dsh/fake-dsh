#!/bin/sh
# The fake `dsh tui` of the SSH attach tests: same contract as the real
# entry point (arguments on argv, answers on stdout), none of the harness.
# Two modes, switched by FAKE_DSH_MODE:
#
#   print (default): prints cwd, DSH_HOME, TERM and every argument, then
#                    exits with ${FAKE_DSH_EXIT:-0}
#   sleep:           prints the same block plus its pid, then lingers with a
#                    child until killed — the disconnect test watches the
#                    whole tree die
mode=${FAKE_DSH_MODE:-print}
echo "cwd=$(pwd)"
echo "DSH_HOME=$DSH_HOME"
echo "TERM=$TERM"
echo "COLUMNS=$COLUMNS"
echo "LINES=$LINES"
i=1
for arg in "$@"; do
    echo "argv$i=$arg"
    i=$((i + 1))
done
echo "pid=$$"
if [ "$mode" = "sleep" ]; then
    # A child the disconnect test can watch die alongside the root.
    sleep 3600 &
    child=$!
    trap 'kill -TERM "$child" 2>/dev/null; exit 0' TERM INT
    while :; do
        sleep 1 &
        wait $!
    done
fi
exit "${FAKE_DSH_EXIT:-0}"
