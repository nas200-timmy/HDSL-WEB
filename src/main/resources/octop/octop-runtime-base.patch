 /**
- * Resolve a path under the Vite-configured public base (``import.meta.env.BASE_URL``).
+ * The mount this build is served under.
+ *
+ * A panel-mounted instance gets a ``<base href="/i/<token>/">`` injected by the
+ * reverse proxy (or ``window.__OCTOP_BASE__`` from an embedding host). Both
+ * change per instance, so the value must be read at runtime: baking the mount
+ * into the bundle is what used to make one build usable for exactly one mount.
+ * Falls back to the Vite build base when the app is opened directly.
+ */
+function runtimeBase(): string {
+  const injected =
+    typeof window !== "undefined"
+      ? (window as unknown as { __OCTOP_BASE__?: string }).__OCTOP_BASE__
+      : undefined;
+  const tag =
+    typeof document !== "undefined"
+      ? document.querySelector("base")?.getAttribute("href")
+      : null;
+  const raw = injected || tag || "";
+  if (raw) {
+    try {
+      const path = new URL(raw, window.location.origin).pathname;
+      return path.endsWith("/") ? path : `${path}/`;
+    } catch {
+      // A malformed base is not worth crashing the app for; use the build base.
+    }
+  }
+  const base = import.meta.env.BASE_URL || "/";
+  return base.endsWith("/") ? base : `${base}/`;
+}
+
+/**
+ * Resolve a path under the runtime mount.
  * Use for static assets and SW registration when the app may be hosted under a subpath.
  */
