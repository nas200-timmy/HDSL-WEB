-  return `${prefix}${cleaned}`;
+  return `${base}${cleaned}`;
 }
 
 /** Router basename: no trailing slash; ``undefined`` when served from domain root. */
 export function routerBasename(): string | undefined {
-  const base = import.meta.env.BASE_URL || "/";
+  const base = runtimeBase();
